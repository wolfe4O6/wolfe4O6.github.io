---
import Base from '../layouts/Base.astro';
import '../styles/postcard.css';
import { projects, projectUrl } from '../data/projects';
---

<Base bare title="Projects" description="Public projects from William Kearns on GitHub.">
  <div class="desk">
    <nav class="card-nav" aria-label="Postcard">
      <a href="/">The card</a>
      <a href="/projects/">Projects</a>
    </nav>
    <div class="slip-page">
      <h1>Projects</h1>
      <p class="lede">Public repositories from GitHub. The descriptions are the ones on each repo.</p>
      <ul class="mail">
        {
          projects.map((project) => (
            <li>
              <a href={projectUrl(project.repo)}>
                <strong>{project.name}</strong>
                <span>{project.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>
