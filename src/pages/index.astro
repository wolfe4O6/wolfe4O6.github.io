---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site } from '../site';
import { getPosts } from '../lib/posts';
import { formatDate, isoDate } from '../lib/dates';

const posts = (await getPosts()).slice(0, 3);
const now = await getEntry('pages', 'now');
if (!now) {
  throw new Error('Missing src/content/pages/now.md');
}
const { Content } = await render(now);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  description: site.description,
  url: site.url,
  homeLocation: {
    '@type': 'Place',
    name: site.location,
  },
  sameAs: [site.github],
};
---

<Base>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </Fragment>

  <header class="intro">
    <p class="kicker">{site.location}</p>
    <h1>{site.name}</h1>
    <p class="lede">{site.description}</p>
    <p class="intro-note">
      A calm little space to check in on what I'm doing, and an archive of me for later.
    </p>
  </header>

  <section class="section" aria-labelledby="now-heading">
    <div class="section-head">
      <h2 id="now-heading">Now</h2>
      <a href="/now/">The full page</a>
    </div>
    {
      now.data.updated && (
        <p class="updated">
          Updated <time datetime={isoDate(now.data.updated)}>{formatDate(now.data.updated)}</time>
        </p>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </section>

  <section class="section" aria-labelledby="recent-heading">
    <div class="section-head">
      <h2 id="recent-heading">Recent</h2>
      <a href="/archive/">All posts</a>
    </div>
    {
      posts.length === 0 ? (
        <p class="empty">
          Nothing filed yet. A new note is a Markdown file in <code>src/content/posts</code>.
        </p>
      ) : (
        <PostList posts={posts} />
      )
    }
  </section>
</Base>
