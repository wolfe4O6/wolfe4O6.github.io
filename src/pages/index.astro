---
import Base from '../layouts/Base.astro';
import Room from '../components/Room.astro';
import { site } from '../site';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  description: site.description,
  url: site.url,
  homeLocation: {
    '@type': 'Place',
    name: site.location,
  },
  sameAs: [site.github],
};
---

<Base bare>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </Fragment>
  <Room />
</Base>
