---
import gallery from '../data/gallery.json';
import flowSource from '../scripts/photo-flow.js?raw';
import controllerSource from '../scripts/photo-controller.js?raw';

// Keep small galleries around the readable center rather than above it.
const slots = gallery.length >= 7 ? [0, 1, 2, 3, 4, 5, 6]
  : gallery.length === 3 ? [2, 3, 5]
  : [2, 3, 1, 4, 5, 6].slice(0, gallery.length);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#edf2e8">
  <meta name="description" content="William Kearns’s personal website in Missoula, Montana.">
  <title>William Kearns · Missoula, Montana</title>
  <link rel="canonical" href="https://williamkearns.org/">
  <style is:global>
    :root { color-scheme:light; --ground:#edf2e8; --ink:#1b392d; --muted:#526a58; --focus:#294f3d;
      background:var(--ground); color:var(--ink); scrollbar-color:#8ba18b var(--ground); }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; scroll-padding-top:6rem; scrollbar-gutter:stable; }
    body { margin:0; font:1rem/1.6 system-ui,sans-serif; overflow-x:clip; }
    ::selection { background:#b8ceb6; color:var(--ink); }
    a { color:inherit; text-underline-offset:.25em; }
    button { color:inherit; font:inherit; cursor:pointer; }
    a:focus-visible,button:focus-visible { outline:2px solid var(--focus); outline-offset:5px; }
    .skip { position:fixed; top:1rem; left:1rem; z-index:20; background:var(--ground); padding:.6rem 1rem; transform:translateY(-200%); }
    .skip:focus { transform:none; }
    .contact-links { position:fixed; top:0; left:0; right:0; z-index:5; display:flex; align-items:center;
      justify-content:flex-end; gap:1.7rem; height:5rem; padding:env(safe-area-inset-top) 2.5rem 0;
      background:transparent; isolation:isolate; }
    .contact-links::before { content:""; position:absolute; z-index:-1; inset:0 0 -2.5rem;
      background:linear-gradient(var(--ground),rgba(237,242,232,.92) 40%,rgba(237,242,232,0));
      -webkit-backdrop-filter:blur(14px); backdrop-filter:blur(14px);
      -webkit-mask-image:linear-gradient(black 40%,transparent); mask-image:linear-gradient(black 40%,transparent);
      pointer-events:none; }
    .contact-links a { display:inline-flex; align-items:center; gap:.5rem; min-height:44px; font-size:.95rem; text-decoration:none; }
    .contact-links a:hover { text-decoration:underline; }
    .contact-links .about-nav { margin-right:auto; }
    .contact-links svg { width:1.15rem; height:1.15rem; }
    .photo-field { position:fixed; inset:0 0 auto; width:100%; height:100svh; overflow:clip; z-index:0;
      -webkit-mask-image:linear-gradient(transparent,black 85px,black calc(100% - 65px),transparent);
      mask-image:linear-gradient(transparent,black 85px,black calc(100% - 65px),transparent); }
    .photo-field::before,.photo-field::after { content:""; position:absolute; left:0; right:0; height:110px;
      z-index:3; pointer-events:none; -webkit-backdrop-filter:blur(9px); backdrop-filter:blur(9px); }
    .photo-field::before { top:0; background:linear-gradient(var(--ground),transparent);
      -webkit-mask-image:linear-gradient(black,transparent); mask-image:linear-gradient(black,transparent); }
    .photo-field::after { bottom:0; background:linear-gradient(transparent,var(--ground));
      -webkit-mask-image:linear-gradient(transparent,black); mask-image:linear-gradient(transparent,black); }
    .photo-field.is-moving .float-photo { left:0; top:0; will-change:transform; }
    .float-photo { position:absolute; left:var(--x); top:var(--y); width:min(var(--width),calc(65svh * var(--ratio))); height:auto;
      aspect-ratio:var(--ratio); padding:0; border:0; border-radius:12px; background:#dbe4d7;
      box-shadow:0 10px 26px -16px rgba(27,57,45,.35); overflow:hidden;
      transition:box-shadow 220ms ease; touch-action:pan-y; }
    .float-photo:hover { box-shadow:0 18px 35px -15px rgba(27,57,45,.4); }
    .float-photo:focus-visible { z-index:4; outline-offset:4px; }
    .float-photo img { width:100%; height:100%; object-fit:contain; display:block; }
    .float-photo[data-slot="0"] { --x:30%; --y:-8%; --width:25vw; }
    .float-photo[data-slot="1"] { --x:3%; --y:50%; --width:22vw; }
    .float-photo[data-slot="2"] { --x:-4%; --y:14%; --width:28vw; }
    .float-photo[data-slot="3"] { --x:79%; --y:12%; --width:27vw; }
    .float-photo[data-slot="4"] { --x:80%; --y:53%; --width:25vw; }
    .float-photo[data-slot="5"] { --x:55%; --y:84%; --width:30vw; }
    .float-photo[data-slot="6"] { --x:6%; --y:84%; --width:18vw; }
    [hidden] { display:none !important; }
    main { position:relative; z-index:1; pointer-events:none; }
    .hero { min-height:100svh; display:grid; place-items:center; padding:8rem 1.5rem 9rem; }
    .identity { width:min(100%,36rem); text-align:center; pointer-events:auto; }
    h1 { margin:0; font:400 clamp(4.6rem,8.7vw,8.25rem)/.96 Georgia,serif; letter-spacing:-.04em; text-wrap:balance; }
    h1 span { display:block; }
    .intro { max-width:28rem; margin:2rem auto 0; font:400 clamp(1.2rem,1.7vw,1.5rem)/1.45 Georgia,serif; text-wrap:pretty; }
    .hero-footer { position:absolute; top:calc(100svh - 5rem); left:2.5rem; right:2.5rem;
      display:flex; align-items:center; justify-content:center; gap:1rem; pointer-events:none; }
    .hero-footer a,.hero-footer button { pointer-events:auto; }
    .about-link { display:inline-flex; align-items:center; gap:.6rem; text-decoration:none; min-height:44px; }
    .about-link:hover { text-decoration:underline; }
    .about-link svg { width:15px; height:15px; }
    .browse { border:0; padding:.5rem 0; background:transparent; min-height:44px; text-decoration:underline; text-underline-offset:.25em; }
    .about { min-height:100svh; display:grid; place-items:center; padding:8rem 1.5rem 10rem; }
    .about-copy { width:min(100%,34rem); pointer-events:auto; }
    h2 { margin:0 0 2rem; font:400 clamp(2.7rem,4vw,3.8rem)/1.1 Georgia,serif; letter-spacing:-.03em; text-wrap:balance; }
    .about p { margin:1.4rem 0 0; font-size:clamp(1.05rem,1.35vw,1.15rem); }
    .page-footer { position:relative; z-index:1; text-align:center; padding:0 1.5rem 2rem; font-size:.85rem; color:var(--muted); }
    .page-footer a { display:inline-block; min-height:44px; padding:.5rem; }
    .viewer { width:min(90vw,74rem); max-width:none; max-height:94svh; padding:0; border:0;
      overflow:visible; background:transparent; color:var(--ink); }
    .viewer[open]::backdrop { background:rgba(237,242,232,.97); -webkit-backdrop-filter:blur(22px); backdrop-filter:blur(22px);
      animation:backdrop-appear 420ms ease both; }
    .viewer.is-closing::backdrop { animation:backdrop-leave 280ms ease both; }
    .viewer[open] .viewer-bottom { animation:caption-appear 240ms 160ms ease both; }
    .viewer.is-closing .viewer-bottom { animation:none; opacity:0; transition:opacity 140ms; }
    @keyframes caption-appear { from { opacity:0; } to { opacity:1; } }
    @keyframes backdrop-appear { from { background:rgba(237,242,232,0); -webkit-backdrop-filter:blur(0); backdrop-filter:blur(0); }
      to { background:rgba(237,242,232,.97); -webkit-backdrop-filter:blur(22px); backdrop-filter:blur(22px); } }
    @keyframes backdrop-leave { from { background:rgba(237,242,232,.97); -webkit-backdrop-filter:blur(22px); backdrop-filter:blur(22px); }
      to { background:rgba(237,242,232,0); -webkit-backdrop-filter:blur(0); backdrop-filter:blur(0); } }
    .viewer-inner { display:flex; flex-direction:column; align-items:center; }
    .viewer-image { display:block; max-width:100%; max-height:72svh; width:auto; height:auto; border-radius:12px; }
    .viewer-bottom { display:flex; align-items:flex-start; gap:2rem; justify-content:space-between; width:min(100%,50rem); margin:1.5rem auto 0; }
    .caption { margin:0; font:400 1.4rem/1.35 Georgia,serif; }
    .date { display:block; color:var(--muted); font:400 .85rem/1.4 system-ui,sans-serif; margin-top:.5rem; }
    .viewer-controls { display:flex; gap:.7rem; flex:none; }
    .icon-button { border:0; padding:.6rem; background:transparent; width:44px; height:44px; display:grid; place-items:center; border-radius:50%; }
    .icon-button:hover { background:#dce6d6; }
    .icon-button svg { width:20px; height:20px; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
    .viewer-close { position:fixed; top:1rem; right:1.5rem; }
    .count { font-size:.8rem; color:var(--muted); margin:.5rem 0 0; font-variant-numeric:tabular-nums; }
    @media (max-width:46rem) {
      .contact-links { height:4.5rem; gap:1.2rem; padding-left:1.25rem; padding-right:1.25rem; }
      .contact-links a { font-size:.9rem; }
      .hero { padding:10rem 1.6rem 10rem; min-height:100svh; }
      h1 { font-size:clamp(4.3rem,18vw,6.5rem); line-height:.97; }
      .identity { width:min(100%,25rem); }
      .intro { width:min(100%,20rem); margin-top:1.5rem; font-size:1.18rem; }
      .hero-footer { left:1.5rem; right:1.5rem; top:calc(100svh - 4.5rem); font-size:.8rem; }
      .float-photo { border-radius:10px; }
      .float-photo[data-slot="0"] { --x:27%; --y:8%; --width:47vw; }
      .float-photo[data-slot="1"] { --x:-18%; --y:66%; --width:48vw; }
      .float-photo[data-slot="2"] { --x:-15%; --y:18%; --width:53vw; }
      .float-photo[data-slot="3"] { --x:78%; --y:20%; --width:47vw; }
      .float-photo[data-slot="4"] { --x:78%; --y:66%; --width:50vw; }
      .float-photo[data-slot="5"] { --x:65%; --y:82%; --width:62vw; }
      .float-photo[data-slot="6"] { --x:-9%; --y:85%; --width:38vw; }
      .about { padding:6rem 2rem 8rem; }
      .about-copy { width:min(100%,28rem); }
      h2 { font-size:2.6rem; margin-bottom:1.5rem; }
      .about p { font-size:1.025rem; line-height:1.65; }
      .viewer { width:88vw; max-height:90svh; }
      .viewer-image { max-height:65svh; }
      .viewer-bottom { gap:1rem; margin-top:1.2rem; }
      .caption { font-size:1.2rem; }
      .viewer-controls { gap:.1rem; }
      .viewer-close { top:.75rem; right:.75rem; }
    }
    @media (prefers-reduced-motion:reduce) {
      html { scroll-behavior:auto; }
      *,*::before,*::after { transition-duration:0s !important; animation:none !important; }
    }
    body:has(.viewer[open]) { overflow:hidden; }
    @media (scripting:none) { .float-photo { opacity:.55; } .identity,.about-copy { background:var(--ground); } .browse { display:none; } }
  </style>
</head>
<body id="top">
  <a class="skip" href="#about">Skip to about me</a>
  <nav class="contact-links" aria-label="Navigation">
    <a class="about-nav" href="#about">About</a>
    <a href="https://github.com/wolfe4O6"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg><span>GitHub</span></a>
    <a href="mailto:wk@williamkearns.org"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>Email</span></a>
  </nav>
  <div class="photo-field" aria-label="Personal photographs" hidden={!gallery.length}>
    <!-- GALLERY_START -->
    {gallery.slice(0, 7).map((photo, index) => (
      <button class="float-photo" type="button" tabindex="-1" data-index={index} data-slot={slots[index]}
        aria-label={`View photo: ${photo.caption || photo.alt}`}
        style={`--ratio:${photo.width / photo.height}`}>
        <img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} decoding="async" />
      </button>
    ))}
    <!-- GALLERY_END -->
  </div>
  <main class={gallery.length ? undefined : "text-only"}>
    <section class="hero" aria-labelledby="name">
      <div class="identity reading-zone">
        <h1 id="name"><span>William</span><span>Kearns</span></h1>
        <p class="intro">I live in Missoula, Montana. I love long days in the woods and late nights making music with friends.</p>
      </div>
      <div class="hero-footer">
        <button class="browse" type="button" hidden={!gallery.length}>Browse photos</button>
      </div>
    </section>
    <section class="about" id="about" aria-labelledby="about-heading">
      <div class="about-copy reading-zone">
        <h2 id="about-heading">A little about me.</h2>
        <p>I’m into backpacking, camping, and traveling. I also like old computers, retro tech, and figuring out how things work.</p>
        <p>I care about the right to repair and being able to build and fix things yourself.</p>
        <p>I play guitar, enjoy DJ sets, and like getting friends together for gaming.</p>
      </div>
    </section>
  </main>
  <footer class="page-footer"><a href="#top">Back to the top</a></footer>
  <dialog class="viewer" aria-label="Photo viewer" aria-describedby="photo-caption">
    <button class="icon-button viewer-close" aria-label="Close photo" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button>
    <div class="viewer-inner">
      <!-- VIEWER_IMAGE_START -->
      <img class="viewer-image" src={gallery[0]?.src} alt={gallery[0]?.alt || ''} />
      <!-- VIEWER_IMAGE_END -->
      <div class="viewer-bottom">
        <div><p class="caption" id="photo-caption"></p><p class="count" aria-live="polite"></p></div>
        <div class="viewer-controls">
          <button class="icon-button previous" type="button" aria-label="Previous photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5-7 7 7 7"/></svg></button>
          <button class="icon-button next" type="button" aria-label="Next photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 5 7 7-7 7"/></svg></button>
        </div>
      </div>
    </div>
  </dialog>
  <!-- GALLERY_DATA_START -->
  <script is:inline type="application/json" id="gallery-data" set:html={JSON.stringify(gallery).replaceAll('<', '\\u003c')}></script>
  <!-- GALLERY_DATA_END -->
  <!-- PHOTO_MOTION_START -->
  <script is:inline set:html={flowSource + '\n' + controllerSource}></script>
  <!-- PHOTO_MOTION_END -->
</body>
</html>
