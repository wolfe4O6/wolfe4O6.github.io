<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#edf2e8">
  <meta name="description" content="William Kearns’s personal website in Missoula, Montana.">
  <title>William Kearns · Missoula, Montana</title>
  <style is:global>
    :root { color-scheme: light; background: #edf2e8; color: #1b392d; }
    * { box-sizing: border-box; }
    body { margin: 0; font: 1rem/1.6 system-ui, sans-serif; }
    main { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .copy { padding: clamp(4rem, 12vh, 8rem) clamp(1.5rem, 6vw, 5.5rem) 4rem; }
    .greeting { margin: 0 0 1rem; font-size: clamp(1.1rem, 2vw, 1.5rem); }
    h1 {
      margin: 0; font: 500 clamp(3.6rem, 10vw, 8.25rem)/.98 Georgia, serif;
      letter-spacing: -.065em; text-wrap: balance;
    }
    h1 span { display: block; }
    .about { max-width: 39rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
    p { margin: 1.25rem 0 0; font-size: clamp(1.05rem, 1.6vw, 1.23rem); }
    .intro {
      margin: 0 0 2rem; font: 400 clamp(1.5rem, 2.5vw, 2rem)/1.35 Georgia, serif;
      letter-spacing: -.02em;
    }
    .photos {
      --photo-gutter: clamp(1rem, 2.5vw, 3rem);
      position: sticky; top: 0; align-self: start; min-width: 0;
      height: 100vh; height: 100svh; padding-right: var(--photo-gutter);
    }
    .photo-scroll {
      height: 100%; overflow-y: auto;
      -webkit-mask-image: linear-gradient(transparent, black 10%, black 90%, transparent);
      mask-image: linear-gradient(transparent, black 10%, black 90%, transparent);
    }
    .photo-scroll:focus-visible { outline: 2px solid #496653; outline-offset: -3px; }
    .photo-group { display: grid; gap: 1.25rem; padding-bottom: 1.25rem; }
    .photo-scroll img { display: block; width: 100%; height: auto; border-radius: .75rem; }
    .photos.is-ready .photo-scroll { overflow: hidden; touch-action: pan-x; }
    .photos.is-ready .photo-track { will-change: transform; }
    .photos::before, .photos::after {
      content: ""; position: absolute; z-index: 1; pointer-events: none;
      left: 0; right: var(--photo-gutter); height: clamp(4rem, 10vh, 7rem);
      -webkit-backdrop-filter: blur(7px); backdrop-filter: blur(7px);
    }
    .photos::before {
      top: 0; background: linear-gradient(#edf2e8, transparent);
      -webkit-mask-image: linear-gradient(black, transparent);
      mask-image: linear-gradient(black, transparent);
    }
    .photos::after {
      bottom: 0; background: linear-gradient(transparent, #edf2e8);
      -webkit-mask-image: linear-gradient(transparent, black);
      mask-image: linear-gradient(transparent, black);
    }
    @media (prefers-reduced-motion: reduce) {
      .photos.is-ready .photo-track { transform: none !important; will-change: auto; }
      .photos.is-ready .photo-scroll { overflow-y: auto; touch-action: auto; }
      .photo-group[aria-hidden="true"] { display: none; }
    }
    @media (max-width: 46rem) {
      main { display: flex; flex-direction: column; }
      .copy { display: contents; }
      .identity { order: 0; padding: 3rem 1.5rem 2rem; }
      .photos {
        --photo-gutter: 0px;
        order: 1; position: relative; height: min(70svh, 35rem);
        width: 100%; padding: 0 1.5rem;
      }
      .photos::before, .photos::after { left: 1.5rem; right: 1.5rem; }
      .about { order: 2; margin: 2rem 1.5rem 3rem; }
    }
  </style>
</head>
<body>
  <main>
    <div class="copy">
      <div class="identity">
        <p class="greeting">Hello, I’m</p>
        <h1><span>William</span> <span>Kearns</span></h1>
      </div>
      <div class="about">
        <p class="intro">Hi, I’m William. I live in Missoula, Montana. I like long days in the woods and late nights making things with friends.</p>
        <p>I’m into backpacking, camping, and traveling. Back home, I like taking old computers apart and figuring out how to fix them. I care about the right to repair and being able to make things yourself.</p>
        <p>There’s usually music in the mix, too. Guitar and DJ sets. Sometimes the best plan is just getting friends together for gaming.</p>
      </div>
    </div>
    <div class="photos">
      <div class="photo-scroll" role="region" aria-label="Personal photos. Scroll or drag to browse. Focus to pause automatic motion." tabindex="0">
        <div class="photo-track">
          <div class="photo-group">
            <img src="/images/valley.jpeg" width="2364" height="1330" fetchpriority="high"
            alt="A wide view across the valley, with green hills, a town, and mountains beneath a cloud-filled sky.">
            <img src="/images/forest-hills.jpeg" width="1182" height="664"
            alt="Clouds drift over dark green forested hills and a golden meadow.">
            <img src="/images/band.jpeg" width="2364" height="1330"
            alt="A view from beside a marching band, with instruments in front of crowded stadium stands.">
            <img src="/images/tower.jpeg" width="2364" height="1330"
            alt="A communications tower rises against a pastel evening sky and a wooded ridge.">
            <img src="/images/sunset.jpeg" width="2364" height="1330"
            alt="Golden sunlight falls across clouds, trees, and the mountain skyline.">
          </div>
        </div>
      </div>
    </div>
  </main>
  <script is:inline>
    const photos = document.querySelector('.photos');
    const viewport = photos.querySelector('.photo-scroll');
    const track = photos.querySelector('.photo-track');
    const group = track.querySelector('.photo-group');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let loopHeight = 0;
    let position = 0;
    let extraSpeed = 0;
    let lastFrame = 0;
    let focused = false;
    let drag = null;

    const copy = group.cloneNode(true);
    copy.setAttribute('aria-hidden', 'true');
    copy.querySelectorAll('img').forEach(image => { image.alt = ''; });
    track.append(copy);

    function renderPosition() {
      if (!loopHeight) return;
      // Wrapping in either direction keeps the two identical groups seamless.
      position = ((position % loopHeight) + loopHeight) % loopHeight;
      track.style.transform = 'translateY(' + (-position) + 'px)';
    }

    new ResizeObserver(() => {
      const nextHeight = group.getBoundingClientRect().height;
      if (loopHeight) position *= nextHeight / loopHeight;
      loopHeight = nextHeight;
      renderPosition();
    }).observe(group);

    viewport.addEventListener('wheel', event => {
      if (reducedMotion.matches || event.ctrlKey || !event.cancelable) return;
      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? viewport.clientHeight : 1;
      const distance = event.deltaY * unit;
      if (!distance) return;
      event.preventDefault();
      position += distance * 0.5;
      extraSpeed = Math.max(-1800, Math.min(1800, extraSpeed + distance * 6));
      renderPosition();
    }, { passive: false });

    viewport.addEventListener('focus', () => { focused = true; });
    viewport.addEventListener('blur', () => { focused = false; });
    viewport.addEventListener('keydown', event => {
      if (reducedMotion.matches) return;
      const steps = { ArrowDown: 80, ArrowUp: -80, PageDown: viewport.clientHeight * 0.8,
        PageUp: -viewport.clientHeight * 0.8, ' ': viewport.clientHeight * 0.8 };
      if (!(event.key in steps) || event.ctrlKey || event.altKey || event.metaKey) return;
      event.preventDefault();
      position += steps[event.key] * (event.key === ' ' && event.shiftKey ? -1 : 1);
      extraSpeed = 0;
      renderPosition();
    });

    viewport.addEventListener('pointerdown', event => {
      if (reducedMotion.matches || event.pointerType === 'mouse' || !event.isPrimary) return;
      viewport.setPointerCapture(event.pointerId);
      drag = { id: event.pointerId, y: event.clientY, time: event.timeStamp };
      extraSpeed = 0;
    });
    viewport.addEventListener('pointermove', event => {
      if (!drag || drag.id !== event.pointerId) return;
      const distance = drag.y - event.clientY;
      position += distance;
      extraSpeed = Math.max(-1800, Math.min(1800, distance * 1000 / Math.max(16, event.timeStamp - drag.time)));
      drag.y = event.clientY;
      drag.time = event.timeStamp;
      renderPosition();
    });
    viewport.addEventListener('pointerup', () => { drag = null; });
    viewport.addEventListener('pointercancel', () => { drag = null; extraSpeed = 0; });

    reducedMotion.addEventListener('change', () => {
      extraSpeed = 0;
      drag = null;
      viewport.scrollTop = 0;
    });
    document.addEventListener('visibilitychange', () => { lastFrame = 0; });

    function animate(time) {
      const elapsed = lastFrame ? Math.min((time - lastFrame) / 1000, 0.05) : 0;
      lastFrame = time;
      if (!reducedMotion.matches && !document.hidden && !drag) {
        const automaticSpeed = focused ? 0 : loopHeight / 125;
        position += (automaticSpeed + extraSpeed) * elapsed;
        extraSpeed *= Math.exp(-2.5 * elapsed);
        renderPosition();
      }
      requestAnimationFrame(animate);
    }

    photos.classList.add('is-ready');
    requestAnimationFrame(animate);
  </script>
</body>
</html>
