<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#edf2e8">
  <meta name="description" content="William Kearns’s personal website in Missoula, Montana.">
  <title>William Kearns · Missoula, Montana</title>
  <style is:global>
    :root { --bar-height: calc(4rem + env(safe-area-inset-top)); color-scheme: light; background: #edf2e8; color: #1b392d; }
    * { box-sizing: border-box; }
    body { margin: 0; font: 1rem/1.6 system-ui, sans-serif; }
    main { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .copy { padding: clamp(3rem, 8vh, 6rem) clamp(1.5rem, 6vw, 5.5rem) 4rem; }
    .greeting { margin: 0 0 1rem; font-size: clamp(1.35rem, 2.7vw, 2rem); font-weight: 500; line-height: 1.3; }
    h1 {
      margin: 0; font: 500 clamp(3.6rem, 10vw, 8.25rem)/.98 Georgia, serif;
      letter-spacing: -.065em; text-wrap: balance;
    }
    h1 span { display: block; }
    .about { max-width: 39rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
    p { margin: 1.25rem 0 0; font-size: clamp(1.05rem, 1.6vw, 1.23rem); }
    .contact-links {
      position: sticky; top: 0; z-index: 5; height: var(--bar-height);
      display: flex; align-items: center; justify-content: flex-end; gap: 1.5rem;
      padding: calc(.5rem + env(safe-area-inset-top)) clamp(1.5rem, 2.5vw, 3rem) .5rem;
      border-bottom: 1px solid #c9d7c5; background: rgba(237, 242, 232, .9);
      -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
      font-size: .95rem;
    }
    .contact-links a {
      display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem;
      color: inherit; text-decoration: none; text-underline-offset: .25em;
    }
    .contact-links a:hover { text-decoration: underline; }
    .contact-links a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
    .contact-links svg { width: 1.15rem; height: 1.15rem; flex: none; }
    .intro {
      margin: 0 0 2rem; font: 400 clamp(1.5rem, 2.5vw, 2rem)/1.35 Georgia, serif;
      letter-spacing: -.02em;
    }
    .photos {
      --photo-gutter: clamp(1rem, 2.5vw, 3rem);
      position: sticky; top: var(--bar-height); align-self: start; min-width: 0;
      height: calc(100vh - var(--bar-height)); height: calc(100svh - var(--bar-height)); padding-right: var(--photo-gutter);
    }
    .photo-scroll {
      height: 100%; overflow-y: auto;
      -webkit-mask-image: linear-gradient(transparent, black 10%, black 90%, transparent);
      mask-image: linear-gradient(transparent, black 10%, black 90%, transparent);
    }
    .photo-scroll:focus-visible { outline: 2px solid #496653; outline-offset: -3px; }
    .photo-group { display: grid; gap: 1.25rem; padding-bottom: 1.25rem; }
    .photo-scroll img { display: block; width: 100%; height: auto; border-radius: .75rem; }
    .photo {
      position: relative; display: block; width: 100%; padding: 0; border: 0;
      border-radius: .75rem; background: transparent; color: white;
      text-align: left; font: inherit; cursor: pointer; overflow: hidden;
    }
    .photo:focus-visible { outline: 3px solid #1b392d; outline-offset: -3px; }
    .photo-caption {
      position: absolute; inset: auto 0 0; padding: 2.5rem 1.25rem 1.25rem;
      background: linear-gradient(transparent, rgba(12, 35, 25, .94));
      font-size: clamp(.95rem, 1.4vw, 1.15rem); line-height: 1.4;
    }
    .photo-caption[hidden] { display: none; }
    .photo-caption time { display: block; margin-top: .4rem; font-size: .8rem; opacity: .85; }
    .photos.is-ready .photo-scroll { overflow: hidden; touch-action: pan-x; }
    .photos.is-ready .photo-track { will-change: transform; }
    .photos::before, .photos::after {
      content: ""; position: absolute; z-index: 1; pointer-events: none;
      left: 0; right: var(--photo-gutter); height: clamp(4rem, 10vh, 7rem);
      -webkit-backdrop-filter: blur(7px); backdrop-filter: blur(7px);
    }
    .photos::before {
      top: 0; background: linear-gradient(#edf2e8, transparent);
      -webkit-mask-image: linear-gradient(black, transparent);
      mask-image: linear-gradient(black, transparent);
    }
    .photos::after {
      bottom: 0; background: linear-gradient(transparent, #edf2e8);
      -webkit-mask-image: linear-gradient(transparent, black);
      mask-image: linear-gradient(transparent, black);
    }
    @media (prefers-reduced-motion: reduce) {
      .photos.is-ready .photo-track { transform: none !important; will-change: auto; }
      .photos.is-ready .photo-scroll { overflow-y: auto; touch-action: auto; }
      .photo-group[aria-hidden="true"] { display: none; }
    }
    @media (max-width: 46rem) {
      main { display: flex; flex-direction: column; }
      .copy { display: contents; }
      .identity { order: 0; padding: 2rem 1.5rem; }
      .photos {
        --photo-gutter: 0px;
        order: 1; position: relative; top: 0; height: min(70svh, 35rem);
        width: 100%; padding: 0 1.5rem;
      }
      .photos::before, .photos::after { left: 1.5rem; right: 1.5rem; }
      .about { order: 2; margin: 2rem 1.5rem 3rem; }
    }
  </style>
</head>
<body>
  <nav class="contact-links" aria-label="Contact links">
    <a href="https://github.com/wolfe4O6"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg><span>GitHub</span></a>
    <a href="mailto:wk@williamkearns.org"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>Email</span></a>
  </nav>
  <main>
    <div class="copy">
      <div class="identity">
        <p class="greeting">Hello, I’m</p>
        <h1><span>William</span> <span>Kearns</span></h1>
      </div>
      <div class="about">
        <p class="intro">Hi, I’m William. I live in Missoula, Montana. I like long days in the woods and late nights making things with friends.</p>
        <p>I’m into backpacking, camping, and traveling. Back home, I like taking old computers apart and figuring out how to fix them. I care about the right to repair and being able to make things yourself.</p>
        <p>There’s usually music in the mix, too. Guitar and DJ sets. Sometimes the best plan is just getting friends together for gaming.</p>
      </div>
    </div>
    <div class="photos">
      <div class="photo-scroll" role="region" aria-label="Personal photos. Scroll or drag to browse. Click a photo for its caption." tabindex="0">
        <div class="photo-track">
          <div class="photo-group">
            <button class="photo" type="button" aria-expanded="false">
              <img src="/images/valley.jpeg?v=2" width="2364" height="1330" fetchpriority="high"
            alt="A wide view across the valley, with green hills, a town, and mountains beneath a cloud-filled sky.">
              <span class="photo-caption" hidden>
                <span>Looking out across the valley.</span>
                <time datetime="2026-05-06">May 6, 2026</time>
              </span>
            </button>
            <button class="photo" type="button" aria-expanded="false">
              <img src="/images/forest-hills.jpeg?v=2" width="1182" height="664"
            alt="Clouds drift over dark green forested hills and a golden meadow.">
              <span class="photo-caption" hidden>
                <span>Low clouds over the forest.</span>
                <time datetime="2026-10-10">October 10, 2026</time>
              </span>
            </button>
            <button class="photo" type="button" aria-expanded="false">
              <img src="/images/band.jpeg?v=2" width="2364" height="1330"
            alt="A view from beside a marching band, with instruments in front of crowded stadium stands.">
              <span class="photo-caption" hidden>
                <span>From beside the band.</span>
                <time datetime="2026-09-11">September 11, 2026</time>
              </span>
            </button>
            <button class="photo" type="button" aria-expanded="false">
              <img src="/images/tower.jpeg?v=2" width="2364" height="1330"
            alt="A communications tower rises against a pastel evening sky and a wooded ridge.">
              <span class="photo-caption" hidden>
                <span>A tower against the evening sky.</span>
                <time datetime="2026-05-05">May 5, 2026</time>
              </span>
            </button>
            <button class="photo" type="button" aria-expanded="false">
              <img src="/images/sunset.jpeg?v=2" width="2364" height="1330"
            alt="Golden sunlight falls across clouds, trees, and the mountain skyline.">
              <span class="photo-caption" hidden>
                <span>Sunset over the hills.</span>
                <time datetime="2026-04-15">April 15, 2026</time>
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script is:inline>
    const photos = document.querySelector('.photos');
    const viewport = photos.querySelector('.photo-scroll');
    const track = photos.querySelector('.photo-track');
    const group = track.querySelector('.photo-group');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let loopHeight = 0;
    let position = 0;
    let extraSpeed = 0;
    let lastFrame = 0;
    let focused = false;
    let drag = null;
    let selectedPhoto = null;
    let suppressClick = false;

    const copy = group.cloneNode(true);
    copy.setAttribute('aria-hidden', 'true');
    copy.querySelectorAll('button').forEach(button => { button.tabIndex = -1; });
    track.append(copy);

    function renderPosition() {
      if (!loopHeight) return;
      // Wrapping in either direction keeps the two identical groups seamless.
      position = ((position % loopHeight) + loopHeight) % loopHeight;
      track.style.transform = 'translateY(' + (-position) + 'px)';
    }

    new ResizeObserver(() => {
      const nextHeight = group.getBoundingClientRect().height;
      if (loopHeight) position *= nextHeight / loopHeight;
      loopHeight = nextHeight;
      renderPosition();
    }).observe(group);

    viewport.addEventListener('wheel', event => {
      if (reducedMotion.matches || event.ctrlKey || !event.cancelable) return;
      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? viewport.clientHeight : 1;
      const distance = event.deltaY * unit;
      if (!distance) return;
      event.preventDefault();
      closeCaption();
      position += distance * 0.5;
      extraSpeed = Math.max(-1800, Math.min(1800, extraSpeed + distance * 6));
      renderPosition();
    }, { passive: false });

    function closeCaption() {
      if (!selectedPhoto) return;
      selectedPhoto.setAttribute('aria-expanded', 'false');
      selectedPhoto.querySelector('.photo-caption').hidden = true;
      selectedPhoto = null;
    }

    track.addEventListener('click', event => {
      if (suppressClick) {
        suppressClick = false;
        return;
      }
      const button = event.target.closest('.photo');
      if (!button) return;
      const wasOpen = selectedPhoto === button;
      closeCaption();
      if (wasOpen) return;
      selectedPhoto = button;
      button.setAttribute('aria-expanded', 'true');
      button.querySelector('.photo-caption').hidden = false;
      extraSpeed = 0;
    });
    document.addEventListener('click', event => {
      if (!event.target.closest('.photo')) closeCaption();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeCaption();
    });

    viewport.addEventListener('focusin', event => {
      focused = event.target.matches(':focus-visible');
      const button = event.target.closest('.photo');
      if (!focused || !button || reducedMotion.matches) return;
      viewport.scrollTop = 0;
      const offset = button.getBoundingClientRect().top - viewport.getBoundingClientRect().top;
      position = Math.max(0, position + offset - 24);
      extraSpeed = 0;
      renderPosition();
    });
    viewport.addEventListener('focusout', event => {
      focused = viewport.contains(event.relatedTarget) &&
        event.relatedTarget.matches(':focus-visible');
    });
    viewport.addEventListener('keydown', event => {
      if (reducedMotion.matches || event.target.closest('.photo')) return;
      const steps = { ArrowDown: 80, ArrowUp: -80, PageDown: viewport.clientHeight * 0.8,
        PageUp: -viewport.clientHeight * 0.8, ' ': viewport.clientHeight * 0.8 };
      if (!(event.key in steps) || event.ctrlKey || event.altKey || event.metaKey) return;
      event.preventDefault();
      position += steps[event.key] * (event.key === ' ' && event.shiftKey ? -1 : 1);
      extraSpeed = 0;
      renderPosition();
    });

    viewport.addEventListener('pointerdown', event => {
      suppressClick = false;
      if (reducedMotion.matches || event.pointerType === 'mouse' || !event.isPrimary) return;
      drag = { id: event.pointerId, y: event.clientY, startY: event.clientY,
        time: event.timeStamp, moving: false };
      extraSpeed = 0;
    });
    viewport.addEventListener('pointermove', event => {
      if (!drag || drag.id !== event.pointerId) return;
      if (!drag.moving) {
        if (Math.abs(drag.startY - event.clientY) < 6) return;
        drag.moving = true;
        closeCaption();
        viewport.setPointerCapture(event.pointerId);
      }
      const distance = drag.y - event.clientY;
      position += distance;
      extraSpeed = Math.max(-1800, Math.min(1800, distance * 1000 / Math.max(16, event.timeStamp - drag.time)));
      drag.y = event.clientY;
      drag.time = event.timeStamp;
      renderPosition();
    });
    viewport.addEventListener('pointerup', () => {
      suppressClick = Boolean(drag && drag.moving);
      drag = null;
    });
    viewport.addEventListener('pointercancel', () => { drag = null; extraSpeed = 0; });

    reducedMotion.addEventListener('change', () => {
      extraSpeed = 0;
      drag = null;
      viewport.scrollTop = 0;
    });
    document.addEventListener('visibilitychange', () => { lastFrame = 0; });

    function animate(time) {
      const elapsed = lastFrame ? Math.min((time - lastFrame) / 1000, 0.05) : 0;
      lastFrame = time;
      if (!reducedMotion.matches && !document.hidden && !drag && !selectedPhoto) {
        const automaticSpeed = focused ? 0 : loopHeight / 125;
        position += (automaticSpeed + extraSpeed) * elapsed;
        extraSpeed *= Math.exp(-2.5 * elapsed);
        renderPosition();
      }
      requestAnimationFrame(animate);
    }

    photos.classList.add('is-ready');
    requestAnimationFrame(animate);
  </script>
</body>
</html>
