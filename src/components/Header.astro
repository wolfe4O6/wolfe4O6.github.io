---
import ThemeToggle from './ThemeToggle.astro';
import Ridge from './Ridge.astro';

const path = Astro.url.pathname;
const archiveOn =
  path.startsWith('/archive') || path.startsWith('/posts') || path.startsWith('/tags');

const links = [
  { href: '/now/', label: 'Now', on: path.startsWith('/now') },
  { href: '/projects/', label: 'Projects', on: path.startsWith('/projects') },
  { href: '/photos/', label: 'Photos', on: path.startsWith('/photos') },
  { href: '/archive/', label: 'Archive', on: archiveOn },
  { href: '/about/', label: 'About', on: path.startsWith('/about') },
];
---

<header class="site-header">
  <div class="stars" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="shell wide header-bar">
    <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <span class="sign">
        <span class="screws" aria-hidden="true"></span>
        <span class="bulbs" aria-hidden="true">
          {Array.from({ length: 8 }, () => <i></i>)}
        </span>
        <span class="sign-name">William Kearns</span>
      </span>
    </a>
    <div class="nav-cluster">
      <nav class="nav" aria-label="Primary">
        {
          links.map((link) => (
            <a href={link.href} aria-current={link.on ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>
  </div>
  <Ridge />
</header>
