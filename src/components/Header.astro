---
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const archiveOn =
  path.startsWith('/archive') || path.startsWith('/posts') || path.startsWith('/tags');
---

<header class="site-header">
  <div class="shell">
    <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <span class="spark" aria-hidden="true">✶</span>
      William Kearns
    </a>
    <div class="nav-cluster">
      <nav class="nav" aria-label="Primary">
        <a href="/now/" aria-current={path.startsWith('/now') ? 'page' : undefined}>Now</a>
        <a href="/archive/" aria-current={archiveOn ? 'page' : undefined}>Archive</a>
        <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
