---
import type { Post } from '../lib/posts';
import { formatDate, isoDate } from '../lib/dates';
import TagList from './TagList.astro';

interface Props {
  posts: Post[];
  variant?: 'list' | 'cards';
}

const { posts, variant = 'list' } = Astro.props;
---

<ol class:list={['post-list', variant === 'cards' && 'post-cards']}>
  {
    posts.map((post) => (
      <li>
        <article class={variant === 'cards' ? 'notecard' : undefined}>
          {variant === 'cards' && <span class="tape" aria-hidden="true" />}
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          <h3>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          </h3>
          <p class="description">{post.data.description}</p>
          <TagList tags={post.data.tags} />
        </article>
      </li>
    ))
  }
</ol>
