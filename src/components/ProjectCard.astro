---
import { projectUrl, type Project } from '../data/projects';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const tilt = ['tilt-a', 'tilt-b', 'tilt-c'][index % 3];
const href = projectUrl(project.repo);
---

<article class:list={['project-card', tilt]}>
  <span class="tape" aria-hidden="true"></span>
  <p class="card-kicker">{project.featured ? 'Pinned' : 'GitHub'}</p>
  <h3>
    <a href={href}>{project.name}</a>
  </h3>
  <p class="project-desc">{project.description}</p>
  {project.name !== project.repo && <p class="repo-slug">{project.repo}</p>}
  <a class="project-link" href={href}>View on GitHub</a>
</article>
