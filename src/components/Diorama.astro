<div class="stage" id="hellgate" data-sky="day" data-weather="sun">
  <div class="stage-canvas" data-view>
    <p class="stage-fallback" data-fallback hidden>
      This browser couldn't start the valley toy. The archive below still works.
    </p>
    <button class="cord" type="button" data-cord aria-label="Pull the lantern cord. Cycles day, golden hour, and night.">
      <span class="cord-line"></span>
      <span class="cord-knob"></span>
    </button>
    <p class="toy-toast" data-toast role="status"></p>
    <p class="weather-live" data-live>Checking the sky over Missoula…</p>
    <div class="toy-controls">
      <button type="button" data-weather-btn="sun" aria-pressed="true">Sun</button>
      <button type="button" data-weather-btn="clouds" aria-pressed="false">Clouds</button>
      <button type="button" data-weather-btn="rain" aria-pressed="false">Rain</button>
      <button type="button" data-weather-btn="snow" aria-pressed="false">Snow</button>
      <button type="button" data-stone>Skip a stone</button>
      <button type="button" data-tube>Drop a tube</button>
    </div>
  </div>
  <div class="stage-plate">
    <p class="kicker">Hellgate Canyon</p>
    <h1>William Kearns</h1>
    <p class="lede">A tinkerer learning the ways of the world.</p>
    <p class="hint">Drag the toy to turn it. Pull the cord for day, golden hour, and night. Tap the M and the L.</p>
  </div>
  <nav class="landmark-row" aria-label="Valley doors">
    <a href="/archive/">Writing</a>
    <a href="/projects/">Projects</a>
    <a href="/photos/">Photos</a>
    <a href="/now/">Now</a>
    <a href="/about/">About</a>
  </nav>
</div>

