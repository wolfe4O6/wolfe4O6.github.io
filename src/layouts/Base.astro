---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/literata/wght.css';
import '@fontsource-variable/literata/wght-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  published?: Date;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  published,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee6" />
    <script is:inline>
      (() => {
        const key = 'theme';
        let theme = 'light';
        try {
          const stored = localStorage.getItem(key);
          if (stored === 'light' || stored === 'dark') theme = stored;
          else if (matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        } catch {
          theme = 'light';
        }
        document.documentElement.dataset.theme = theme;
        const color = document.querySelector('meta[name="theme-color"]');
        if (color) color.setAttribute('content', theme === 'dark' ? '#1b1714' : '#f3eee6');
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} RSS`}
      href={new URL('/rss.xml', Astro.site)}
    />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="me" href={site.github} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <div class="shell">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
